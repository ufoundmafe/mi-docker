datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Puedes añadir aquí abajo los modelos para el Flood si tu app los requiere, por ejemplo:
model EvidenciaEstres {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  metrica   String
}
